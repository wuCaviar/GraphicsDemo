/* ============================================================
   GraphicsDemo - GIMP-Inspired Dark Theme
   ============================================================ */

/* ---- Global ---- */
* {
    font-family: "SF Pro Display", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #2d2d2d;
}

QWidget {
    color: #e0e0e0;
    background-color: #353535;
}

/* ---- Menu Bar ---- */
QMenuBar {
    background-color: #333333;
    border-bottom: 1px solid #4a4a4a;
    padding: 2px 4px;
    spacing: 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
    color: #d0d0d0;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #4a4a4a;
}

QMenu {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 28px 6px 16px;
    border-radius: 4px;
    margin: 1px 4px;
    color: #d0d0d0;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: #215d9c;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #4a4a4a;
    margin: 4px 8px;
}

/* ---- Tool Bar ---- */
QToolBar {
    background-color: #333333;
    border-bottom: 1px solid #4a4a4a;
    padding: 3px 6px;
    spacing: 2px;
    min-height: 38px;
}

QToolBar::separator {
    width: 1px;
    background: #555555;
    margin: 4px 6px;
}

QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    min-width: 32px;
    min-height: 28px;
    color: #c0c0c0;
}

QToolBar QToolButton:hover {
    background-color: #4a4a4a;
    border: 1px solid #555555;
}

QToolBar QToolButton:pressed {
    background-color: #555555;
}

QToolBar QToolButton:checked {
    background-color: #1e3d5c;
    border: 1px solid #4d8bc9;
    color: #4d8bc9;
}

QToolBar QToolButton:checked:hover {
    background-color: #254d6e;
}

QToolBar QToolButton::menu-indicator {
    image: none;
}

/* ---- Status Bar ---- */
QStatusBar {
    background-color: #333333;
    border-top: 1px solid #4a4a4a;
    padding: 2px 10px;
    color: #aaaaaa;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #aaaaaa;
    padding: 0px 4px;
}

QStatusBar QSlider {
    margin: 0px 4px;
}

QStatusBar QFrame#StatusBarSeparator {
    color: #555555;
    margin: 0px 8px;
}

/* ---- Dock Widget (Property Panel) ---- */
QDockWidget {
    titlebar-close-icon: none;
    border: none;
    background-color: #353535;
}

QDockWidget::title {
    background-color: #3c3c3c;
    border-bottom: 1px solid #4a4a4a;
    padding: 8px 12px;
    text-align: left;
    font-weight: 600;
    font-size: 12px;
    color: #cccccc;
}

QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
    border-radius: 3px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #4a4a4a;
}

/* ---- Group Box ---- */
QGroupBox {
    background-color: #3c3c3c;
    border: 1px solid #4a4a4a;
    border-radius: 6px;
    margin-top: 12px;
    padding: 16px 10px 10px 10px;
    font-weight: 500;
    font-size: 12px;
    color: #d0d0d0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    background-color: #3c3c3c;
    color: #cccccc;
    border-radius: 3px;
}

/* ---- Input Widgets ---- */
QSpinBox, QDoubleSpinBox {
    background-color: #424242;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 3px 6px;
    min-height: 24px;
    color: #e0e0e0;
    selection-background-color: #215d9c;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #4d8bc9;
}

QSpinBox:read-only, QDoubleSpinBox:read-only {
    background-color: #3a3a3a;
    color: #888888;
}

QComboBox {
    background-color: #424242;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 24px;
    color: #e0e0e0;
}

QComboBox:hover {
    border-color: #666666;
}

QComboBox:focus {
    border-color: #4d8bc9;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #aaaaaa;
}

QComboBox QAbstractItemView {
    background-color: #424242;
    border: 1px solid #555555;
    border-radius: 4px;
    selection-background-color: #215d9c;
    selection-color: #ffffff;
    outline: none;
    color: #e0e0e0;
}

QFontComboBox {
    background-color: #424242;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 24px;
    color: #e0e0e0;
}

QFontComboBox:focus {
    border-color: #4d8bc9;
}

QLineEdit {
    background-color: #424242;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 24px;
    color: #e0e0e0;
    selection-background-color: #215d9c;
}

QLineEdit:focus {
    border-color: #4d8bc9;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #424242;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 24px;
    color: #d0d0d0;
}

QPushButton:hover {
    background-color: #4a4a4a;
    border-color: #666666;
}

QPushButton:pressed {
    background-color: #555555;
}

QPushButton:checked {
    background-color: #1e3d5c;
    border-color: #4d8bc9;
    color: #4d8bc9;
}

QPushButton:disabled {
    background-color: #3a3a3a;
    color: #777777;
    border-color: #4a4a4a;
}

/* ---- Scroll Bar ---- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #555555;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #666666;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #555555;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #666666;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---- Slider ---- */
QSlider::groove:horizontal {
    height: 4px;
    background: #555555;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #4d8bc9;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #5d9bd9;
}

QSlider::sub-page:horizontal {
    background: #4d8bc9;
    border-radius: 2px;
}

/* ---- Scroll Area ---- */
QScrollArea {
    border: none;
    background: transparent;
}

/* ---- Tab Widget ---- */
QTabWidget::pane {
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    background: #3c3c3c;
}

QTabBar::tab {
    background: #424242;
    border: 1px solid #4a4a4a;
    border-bottom: none;
    padding: 6px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #aaaaaa;
}

QTabBar::tab:selected {
    background: #3c3c3c;
    border-bottom: 2px solid #4d8bc9;
    color: #e0e0e0;
}

/* ---- Tooltip ---- */
QToolTip {
    background-color: #4a4a4a;
    color: #e0e0e0;
    border: 1px solid #666666;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background: #4a4a4a;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* ---- Ruler Corner Widget ---- */
RulerCorner {
    background-color: #3c3c3c;
}

/* ---- Graphics View Frame ---- */
QAtGraphicsView {
    border: none;
    background-color: #1e1e1e;
}
